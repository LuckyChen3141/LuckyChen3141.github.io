1:["$","div",null,{"className":"about-page","children":[["$","header",null,{"className":"page-heading","children":[["$","p",null,{"className":"eyebrow","children":"About me"}],["$","h1",null,{"children":["An engineering foundation.",["$","br",null,{}],"A focus on operations."]}]]}],["$","div",null,{"className":"about-intro","children":[["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"I go by Luke. I am a PhD student in Operations and Technology Management at the Questrom School of Business, Boston University. My research interests center on AI token pricing, alongside energy markets, electric vehicles, and sustainability. I approach these topics through optimization, market design, and incentives."}],["$","p",null,{"children":"I began my doctoral studies at Boston University in Systems Engineering before moving to Questrom. Earlier, I earned a Bachelor of Engineering at the Southern University of Science and Technology (SUSTech) and spent a semester at the University of Toronto."}],["$","p",null,{"children":"My research experience spans vehicle-to-grid energy trading, cybersecurity, integrated sensing and communication, and robotics. I am interested in connecting these technical foundations with questions about incentives, coordination, and sustainable mobility."}],["$","a",null,{"className":"primary-link","href":"/yunwang-chen-cv.pdf","download":true,"children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 15V3","key":"m9g1x1"}],["path",{"d":"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4","key":"ih7n3h"}],["path",{"d":"m7 10 5 5 5-5","key":"brsn70"}]],"className":"lucide-download","size":17,"aria-hidden":"true"}]," Download CV ",["$","span",null,{"className":"button-note","children":"PDF · September 2026"}]]}]]}],["$","aside",null,{"className":"profile-aside","children":[["$","h2",null,{"children":"Find me"}],["$","span",null,{"className":"contact-email","children":"chen314 [at] bu [dot] edu"}],["$","a",null,{"href":"http